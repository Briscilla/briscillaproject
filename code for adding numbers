def add_two_numbers(a, b):
    """Add two numbers and return the result."""
    return a + b


def add_multiple_numbers(*args):
    """Add any number of arguments and return the result."""
    return sum(args)


def add_numbers_from_list(numbers):
    """Add all numbers in a list and return the result."""
    return sum(numbers)


